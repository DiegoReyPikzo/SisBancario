<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sisbancario.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Pane prefHeight="396.0" prefWidth="862.0">
         <children>
            <Label layoutX="78.0" layoutY="41.0" text="Bienvenido al portal de banca Bañorte" textAlignment="CENTER">
               <font>
                  <Font name="Fira Code Regular" size="18.0" />
               </font>
            </Label>
            <Label layoutX="80.0" layoutY="108.0" text="Ingresa tu usuario:">
               <font>
                  <Font name="Fira Code Regular" size="12.0" />
               </font></Label>
            <Label layoutX="60.0" layoutY="156.0" text="Ingresa tu contraseña:">
               <font>
                  <Font name="Fira Code Regular" size="12.0" />
               </font></Label>
            <TextField fx:id="usuario" layoutX="233.0" layoutY="104.0" promptText="usuario" />
            <TextField fx:id="contrasena" layoutX="234.0" layoutY="152.0" promptText="contraseña" />
            <Button fx:id="btnIniciar" layoutX="159.0" layoutY="207.0" mnemonicParsing="false" onAction="#onSesion" text="Iniciar sesión">

               <font>
                  <Font name="Fira Code Regular" size="12.0" />
               </font></Button>
            <ImageView fitHeight="90.0" fitWidth="140.0" layoutX="138.0" layoutY="278.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@Imagenes/Link%208-Bit.jpg" />
               </image></ImageView>
            <Label fx:id="mensajeError" layoutX="168.0" layoutY="251.0" />
         </children></Pane>
   </children>
</VBox>
